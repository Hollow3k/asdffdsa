# Copy to .env (never commit .env). Used by docker-compose.yml.

# Required: password for the bundled PostgreSQL. Use a long random value.
POSTGRES_PASSWORD=change-me

# Browser origin(s) allowed to call the API (comma separated). Must match where users open the site.
CORS_ORIGINS=http://localhost:8080
# Public port of the web container.
WEB_PORT=8080

# Leave empty when nginx proxies /api (default). Only set if the API is on another origin,
# e.g. https://api.example.com  (then add this site's origin to CORS_ORIGINS).
VITE_API_BASE_URL=

LOG_LEVEL=INFO
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# --- Local development without Docker (backend/.env) -------------------------------------------
# DATABASE_URL=sqlite:///./data/wind.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wind
# Optional tuning: ELEXON_TIMEOUT_SECONDS, ELEXON_MAX_RETRIES, ELEXON_BACKOFF_BASE_SECONDS,
# DEFAULT_CALIBRATION_START/END, DECISION_WINDOW_START/END, MIN_CALIBRATION_PAIRS, MAX_CALIBRATION_DAYS
